[Desktop Entry]
Type=Application
Name=WriteMind
GenericName=Notebook
Comment=A notebook, a camera and a drawing layer over both
Exec=writemind %F
Icon=writemind
Terminal=false
Categories=Office;TextEditor;
MimeType=application/vnd.writemind.note+zip;application/vnd.writemind.markdownnote;text/markdown;
Keywords=notes;notebook;writing;drawing;
StartupWMClass=WriteMind
