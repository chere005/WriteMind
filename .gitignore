# xcodebuild output (tools/build.sh, tools/test.sh) and the staged bundle
build/
dist/
DerivedData/

# Xcode's per-user state; the shared scheme under xcshareddata IS tracked
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# Claude Code machine-local state; launch.json would be repo config and tracked
.claude/*
!.claude/launch.json

*.log
.DS_Store

# The TypeScript port
node_modules/
out/
.vite/
*.tsbuildinfo

# The compiled macOS helper: built by tools/build-vision.sh, never committed
apps/desktop/out/

# electron-builder output
dist-electron/

# The shortcut icon tools/setup-windows.ps1 makes from packaging/icon.png
packaging/writemind.ico

# End-to-end runs: reports, screenshots, logs, the build snapshot and scratch scripts
e2e/.results/
e2e/.snapshot/
e2e/.scratch/
