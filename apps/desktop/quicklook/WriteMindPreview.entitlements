<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Quick Look extension's OWN entitlements (apps/desktop/scripts/sign-mac.cjs signs it with these, never with
     packaging/entitlements.mac.plist): the App Sandbox, which macOS requires of a Quick Look extension, and read access
     to the file Quick Look hands it. No JIT, no network, no camera: JavaScriptCore runs the page's script in its
     interpreter, which is fast enough for a page. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
</dict>
</plist>
