{
  "name": "@writemind/desktop",
  "version": "2.12.0",
  "private": true,
  "type": "module",
  "main": "out/main/main.mjs",
  "scripts": {
    "build:app": "node scripts/build.mjs",
    "build": "vite build && node scripts/build.mjs && node scripts/build-vision.mjs",
    "start": "node scripts/mac-dev-identity.mjs && electron .",
    "dev": "node scripts/dev.mjs",
    "package": "npm run build && electron-builder --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:mac:adhoc": "electron-builder --mac dmg --arm64 --x64 --publish never --config electron-builder.yml -c.mac.identity=- -c.forceCodeSigning=true -c.mac.timestamp=none -c.mac.notarize=false -c.mac.hardenedRuntime=false"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "description": "WriteMind: a notebook, a camera and a drawing layer over both",
  "author": "Shahean Cheren"
}
